{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2022", "DOM"], "module": "ESNext",
    "moduleResolution": "Bundler", "jsx": "react-jsx", "strict": true,
    "skipLibCheck": true, "types": ["vite/client", "@cloudflare/workers-types"],
    "noEmit": true, "allowImportingTsExtensions": true
  },
  "include": ["src", "worker", "vite.config.ts"]
}
